<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SS14Editor.SchemaCli</AssemblyName>
    <RootNamespace>Content.Editor</RootNamespace>

    <!-- Framework-dependent, one managed artifact for every OS. The plugin
         invokes it as `dotnet SS14Editor.SchemaCli.dll`. The "fork must be
         built" precondition guarantees a .NET SDK is present. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <SelfContained>false</SelfContained>
    <!-- No native apphost (`.exe` on Windows): it would make the .vsix depend
         on the OS it was packaged on, and the plugin never launches it. -->
    <UseAppHost>false</UseAppHost>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Keep output flat: bin/<config>/net8.0/SS14Editor.SchemaCli.dll -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

  <!-- The tests/ folder is a separate xUnit project; exclude it from this build. -->
  <ItemGroup>
    <Compile Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>

</Project>
