# The TS is bundled into dist/ by esbuild; the schema extractor is published
# into assets/schema-cli/ by `npm run build:schema-cli`. Ship those, the
# Marketplace page files (README, CHANGELOG, LICENSE) and the icon with its
# attribution (assets/icon.*), nothing else. assets/ is intentionally NOT
# excluded here.
.github/**
.vscode/**
.vscode-test/**
.vscode-test.mjs
.claude/**
docs/**
schema-cli/**
out/**
src/**
test/**
node_modules/**
**/*.ts
**/*.map
esbuild.mjs
eslint.config.mjs
vitest.config.ts
tsconfig.json
.gitignore
.gitattributes
CLAUDE.md
CONTEXT.md
.eslintcache
assets/**/*.pdb
rider-plugin/**
# The language server is the Rider plugin's; the VS Code host does not load it.
dist/server.js
