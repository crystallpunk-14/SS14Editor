{
  "name": "ss14editor",
  "displayName": "SS14 Prototype Editor",
  "description": "Autocomplete, hover docs and go-to-definition for Space Station 14 YAML prototypes, built from your fork's code.",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "TheShuEd",
  "private": true,
  "icon": "assets/icon.png",
  "keywords": [
    "ss14",
    "space station 14",
    "robust toolbox",
    "prototypes",
    "yaml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crystallpunk-14/SS14Editor.git"
  },
  "homepage": "https://github.com/crystallpunk-14/SS14Editor#readme",
  "bugs": {
    "url": "https://github.com/crystallpunk-14/SS14Editor/issues"
  },
  "engines": {
    "vscode": "^1.49.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ss14editor.rebuildSchema",
        "title": "Rebuild schema",
        "category": "SS14"
      },
      {
        "command": "ss14editor.rebuildPrototypeIndex",
        "title": "Rebuild prototype index",
        "category": "SS14"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "build:schema-cli": "node -e \"require('fs').rmSync('assets/schema-cli',{recursive:true,force:true})\" && dotnet publish schema-cli/SS14Editor.SchemaCli.csproj -c Release -o assets/schema-cli",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:core": "vitest run",
    "pretest:smoke": "npm run build",
    "test:smoke": "vscode-test",
    "test": "npm run test:core && npm run test:smoke",
    "package": "npm run build && npm run build:schema-cli && vsce package --no-dependencies -o ss14editor.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.16.11",
    "@types/vscode": "^1.49.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "yaml": "^2.8"
  }
}
